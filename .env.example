# Base URL of the Laravel API backend
VITE_API_URL=http://localhost:8000

# Display name on authentication and public-board pages; index.html sets the tab title.
VITE_APP_NAME="SaaS Boilerplate"

# Use Reverb for local live updates. Ably configuration has not been verified.
VITE_BROADCAST_DRIVER=reverb

# Match the backend REVERB_APP_KEY; never copy its REVERB_APP_SECRET here.
VITE_REVERB_APP_KEY=your-reverb-app-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Optional Ably compatibility configuration; do not put a full secret key here.
# VITE_ABLY_KEY=your-ably-public-key
# VITE_ABLY_CLUSTER=eu

# Optional Google login; the redirect URI uses the browser's origin.
# VITE_GOOGLE_CLIENT_ID=your-google-client-id
