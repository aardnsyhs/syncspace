# Base URL of the Laravel API backend
VITE_API_URL=http://localhost:8000

# Display name shown in the UI (auth pages, footer, browser tab)
VITE_APP_NAME="SaaS Boilerplate"

# -----------------------------------------------------------------------
# Broadcasting / WebSockets
# -----------------------------------------------------------------------
# Options: "reverb" (default, self-hosted) | "ably" (managed cloud)
VITE_BROADCAST_DRIVER=reverb

# Laravel Reverb (self-hosted — recommended for local development)
# Run "php artisan reverb:start" in the backend to start the server.
VITE_REVERB_APP_KEY=your-reverb-app-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Ably (managed cloud — optional, for production)
# Set VITE_BROADCAST_DRIVER=ably and fill in your key to use Ably instead.
# VITE_ABLY_KEY=your-ably-public-key
# VITE_ABLY_CLUSTER=eu

# -----------------------------------------------------------------------
# Google OAuth (optional — remove if not using Google login)
# -----------------------------------------------------------------------
# VITE_GOOGLE_CLIENT_ID=your-google-client-id
